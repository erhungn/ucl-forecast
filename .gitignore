# Virtual environment
.venv/

# Data and outputs: regenerated by the pipeline, never committed
data/raw/*
data/processed/*
outputs/*
!**/.gitkeep

# ... except the hand-curated inputs and the provenance records, which are
# small, verified by hand, and needed to reproduce a run on another machine.
!data/raw/teams_*.csv
!data/raw/team_names.csv
!data/raw/name_decisions.csv
!data/raw/fixtures_*.csv
!data/raw/pots_*.csv
!data/raw/outright_odds_*.csv
# Descend into the download directories (git skips an excluded directory
# entirely) so their manifests can be re-included, but keep the payload out.
!data/raw/*/
data/raw/*/*
!data/raw/*/manifest.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# The Transfermarkt club-name mapping and the decisions behind it.
!data/raw/transfermarkt_club_map.csv
!data/raw/transfermarkt_decisions.csv

# The app environment and its secrets; live/ is tracked on purpose, since each
# file there is a dated point-in-time forecast the app's history is built on.
.venv-app/
.streamlit/secrets.toml
live/*/update.log
live/*/update.log.1
live/*/*.tmp
